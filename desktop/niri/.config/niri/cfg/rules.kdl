    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
	match title="wayprompt"
	open-floating true
    }

    // ─── Picture-in-picture ───
    // A PiP window is a video the size of a postage stamp; tiled into a column
    // it either squashes the real work or gets squashed by it, which defeats
    // the entire point of detaching it. Float it instead — floating windows sit
    // above the tiled layout in niri, so it behaves like the always-on-top
    // overlay it is meant to be.
    //
    // Two titles because the browsers disagree on the hyphens: Firefox and its
    // derivatives (zen here) use "Picture-in-Picture", Chromium and Electron
    // apps use "Picture in picture". Matching on title rather than app-id is
    // deliberate — the PiP window carries the same app-id as the main browser
    // window, so an app-id match would float the browser too.
    window-rule {
	match title="^Picture-in-Picture$"
	match title="^Picture in picture$"
	open-floating true
	default-floating-position x=32 y=32 relative-to="bottom-right"
    }

    // ─── Games ───
    // Steam gives each game an app-id of steam_app_<id>; gamescope-wrapped
    // launches show up as gamescope instead, so both are matched.
    //
    // open-on-output puts them on the Acer, which is both the larger and the
    // faster panel — 180Hz against the laptop's 144. niri falls back to the
    // focused output when it is not connected, so this is safe undocked.
    //
    // variable-refresh-rate marks these windows as the ones VRR is for. It is
    // inert today: Monique's niri backend collapses on-demand VRR to plain
    // always-on (models.py, "if self.vrr != VRR.OFF"), so the Acer runs VRR
    // full time regardless. The rule is here so this starts behaving properly
    // the moment Monique emits on-demand. See the README.
    window-rule {
	match app-id=r#"^steam_app_"#
	match app-id=r#"^gamescope$"#
	open-on-output "Acer Technologies ED240Q S3 234006B6B3W01"
	variable-refresh-rate true
    }
