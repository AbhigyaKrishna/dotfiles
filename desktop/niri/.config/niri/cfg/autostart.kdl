// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    // No kwalletd here on purpose. gnome-keyring owns org.freedesktop.secrets
    // on this machine — check with `busctl --user list | grep secrets` — so
    // every Secret Service client already stores there, and a second wallet
    // daemon only produced a second unlock prompt in a different toolkit's
    // style. The leftover ~/.local/share/kwalletd/kdewallet.kwl is kept rather
    // than deleted; nothing reads it while no daemon runs. See the keyring
    // note under "Root-owned pieces" for the kwallet-pam half of this.
    spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1 &" // Polkit
    spawn-sh-at-startup "qs -c noctalia-shell"
    spawn-sh-at-startup "/usr/bin/nirinit --save-interval 300 &"
    spawn-sh-at-startup "xsettingsd &" // XSETTINGS for X11/XWayland apps

    // Wayland hands the clipboard to the *window* that owns it, so closing the
    // app you copied from empties it. cliphist still has the text, but only
    // through the picker — a plain Ctrl+V right after closing pastes nothing.
    // wl-clip-persist keeps ownership alive instead. Regular clipboard only:
    // doing the same to the primary selection makes every stray text drag
    // fight with whatever middle-click paste is expected to do.
    spawn-sh-at-startup "wl-clip-persist --clipboard regular &"
