# Switch the power profile when the charger is plugged in or pulled out.
#
# power-profiles-daemon is already present for the desktop tier — it is an
# optdepend of noctalia-shell, whose bar has a PowerProfile widget. The daemon
# exposes the profiles but does not choose between them, and the widget only
# makes that choice manual. This rule automates it: it fires on every AC
# adapter state change and hands off to power-profile-auto.sh.
#
# Not installable by stow: it belongs to root under /etc. See the README.
#
#   sudo install -Dm644 meta/system/udev/99-power-profile.rules \
#     /etc/udev/rules.d/99-power-profile.rules
#   sudo udevadm control --reload

SUBSYSTEM=="power_supply", KERNEL=="AC*", ACTION=="change", RUN+="/usr/local/bin/power-profile-auto.sh"
