#!/usr/bin/env bash
# CPU thermal and power caps for the HP Pavilion Gaming 15-ec2xxx (5600H/3050).
# NBFC controls the fans; these limits reduce CPU heat in the shared cooler.
#
# AMD specifies a 105°C maximum junction temperature for the 5600H. The 90°C
# target below is a cooling preference, not the processor's hardware maximum.
# Source: https://www.amd.com/en/support/downloads/drivers.html/processors/ryzen/ryzen-5000-series/amd-ryzen-5-5600h.html
#
# A local 10-worker PBKDF2 comparison on 2026-10-27 measured 410 work units/s
# with 40/55/45 W versus 369-388 with the old 35/45/38 W limits. Stock-like
# 45/65/54 W reached the 90°C target for only 0.8% more throughput. Each run
# lasted 60 seconds with 15 seconds of warmup; these are CPU throughput results,
# not game FPS measurements. GPU activity varied with the game left open.
#
# SMU settings are volatile. The service applies them at boot/resume and its
# timer caps them while awake. Preserve lower limits chosen by the system's
# power/thermal manager instead of repeatedly raising them during GPU load.
# See ryzenadj-thermal.service to install.

set -euo pipefail

# Junction-temperature target, °C.
TCTL=90

# Sustained power budget, mW, averaged over the firmware's STAPM time window.
STAPM=40000

# Short-burst ceiling, mW, to retain responsiveness without the stock 65 W burst.
FAST=55000

# Medium-window ceiling, mW, before the sustained budget takes over.
SLOW=45000

ryzenadj=/usr/bin/ryzenadj
[ -x "$ryzenadj" ] || { echo "ryzenadj not present at $ryzenadj" >&2; exit 1; }

build_cap_arguments() {
    awk -F '|' -v temperature="$TCTL" -v sustained="$STAPM" \
        -v fast="$FAST" -v slow="$SLOW" '
        BEGIN {
            maximum["STAPM LIMIT"] = sustained
            maximum["PPT LIMIT FAST"] = fast
            maximum["PPT LIMIT SLOW"] = slow
            maximum["THM LIMIT CORE"] = temperature
            option["STAPM LIMIT"] = "--stapm-limit"
            option["PPT LIMIT FAST"] = "--fast-limit"
            option["PPT LIMIT SLOW"] = "--slow-limit"
            option["THM LIMIT CORE"] = "--tctl-temp"
        }
        {
            name = $2
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            if (!(name in maximum)) next
            seen[name]++
            value = $3
            gsub(/[[:space:]]/, "", value)
            if (value !~ /^[0-9]+([.][0-9]+)?$/ || value <= 0) {
                print "Invalid SMU metric: " name > "/dev/stderr"
                invalid = 1
                next
            }
            current[name] = value * (name == "THM LIMIT CORE" ? 1 : 1000)
        }
        END {
            for (name in maximum) {
                if (seen[name] != 1) {
                    print "Missing or duplicate SMU metric: " name > "/dev/stderr"
                    invalid = 1
                }
            }
            if (invalid) exit 1
            for (name in maximum) {
                if (current[name] > maximum[name])
                    printf "%s=%.0f\n", option[name], maximum[name]
            }
        }'
}

if ! current_limits=$("$ryzenadj" --info); then
    echo "Failed to read current Ryzen SMU limits; leaving them unchanged" >&2
    exit 1
fi

arguments_text=$(build_cap_arguments <<< "$current_limits")
if [[ -z "$arguments_text" ]]; then
    echo "limits already at or below configured caps; preserving them"
    exit 0
fi

mapfile -t cap_arguments <<< "$arguments_text"
"$ryzenadj" "${cap_arguments[@]}"

printf 'capped: %s\n' "${cap_arguments[*]}"
