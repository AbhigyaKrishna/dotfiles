#!/usr/bin/env bash
# niri-power-action — power-state-aware session actions for niri + noctalia.
#
# Modes:
#   lid-close     Lock. On battery, suspend now if critically low, else after
#                 LID_GRACE seconds of the lid staying shut. Does nothing at
#                 all when an external display is attached (clamshell mode).
#   lid-open      Cancel any pending lid-close suspend.
#   idle-suspend  Suspend, but only when running on battery.
#
# The point of all of it is that locking and suspending are separate things.
# Closing the lid or walking away locks the screen while background work
# (builds, downloads, music, SSH sessions) keeps running. The machine only
# actually suspends when staying awake would drain a battery, never on mains.
#
# Wired up from:
#   ~/.config/niri/cfg/lid.kdl        — switch-events { lid-close / lid-open }
#   ~/.config/noctalia/settings.json  — idle.customCommands

set -u

# Battery percentage at or below which closing the lid suspends immediately
# rather than waiting out the grace period.
CRITICAL_PCT=20

# How long the lid may stay shut on battery before suspending.
LID_GRACE=600

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/niri-power-action.lid"

lock() {
    qs -c noctalia-shell ipc call lockScreen lock 2>/dev/null || true
}

# Returns 0 when a mains supply is plugged in and online, 1 on battery.
on_ac() {
    local t
    for t in /sys/class/power_supply/*/type; do
        [ -r "$t" ] || continue
        [ "$(cat "$t")" = "Mains" ] || continue
        [ "$(cat "${t%/type}/online" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

# Echoes mean charge across all batteries as a percentage, or nothing at all
# on a machine with no battery (in which case callers must not suspend).
battery_pct() {
    local c sum=0 n=0
    for c in /sys/class/power_supply/*/capacity; do
        [ -r "$c" ] || continue
        [ "$(cat "${c%/capacity}/type" 2>/dev/null)" = "Battery" ] || continue
        sum=$((sum + $(cat "$c")))
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] && echo $((sum / n))
}

lid_is_closed() {
    grep -qi closed /proc/acpi/button/lid/*/state 2>/dev/null
}

# Suspend to RAM, then hibernate once it has been asleep a while — see
# meta/system/sleep.conf.d/10-hibernate.conf. Falls back to a plain suspend so
# a machine that cannot hibernate still sleeps rather than staying awake.
sleep_now() {
    systemctl suspend-then-hibernate || systemctl suspend
}

# Returns 0 when a display other than the laptop panel is plugged in, i.e. the
# lid closing means clamshell mode rather than walking away. Read from DRM
# sysfs rather than `niri msg` so this needs no JSON parser and stays correct
# if the compositor is not answering.
has_external_display() {
    local s conn
    for s in /sys/class/drm/*/status; do
        [ -r "$s" ] || continue
        conn=${s%/status}
        conn=${conn##*/} # e.g. card2-eDP-1
        case "$conn" in
        *-eDP-* | *-LVDS-* | *-DSI-*) continue ;; # the built-in panel
        esac
        [ "$(cat "$s")" = "connected" ] && return 0
    done
    return 1
}

cancel_pending() {
    [ -f "$PIDFILE" ] || return 0
    local pid
    read -r pid <"$PIDFILE" 2>/dev/null || true
    [ -n "${pid-}" ] && kill "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    return 0
}

# Suspend once the lid has stayed shut, on battery, for the whole grace period.
# Re-checks both conditions at fire time so a missed lid-open event cannot
# suspend a machine that is open and in use.
schedule_suspend() {
    cancel_pending
    (
        sleep "$LID_GRACE"
        lid_is_closed || exit 0
        on_ac && exit 0
        rm -f "$PIDFILE"
        sleep_now
    ) &
    echo $! >"$PIDFILE"
}

case "${1-}" in
lid-close)
    # Clamshell: an external display is attached, so the lid closing means the
    # laptop is docked at a desk rather than being carried away. Keep working
    # on the external screen — do not lock, do not schedule a suspend. Actually
    # walking away is still caught by the idle stages, which lock regardless.
    if has_external_display; then
        exit 0
    fi
    lock
    if ! on_ac; then
        pct=$(battery_pct)
        if [ -n "$pct" ] && [ "$pct" -le "$CRITICAL_PCT" ]; then
            sleep 1 # let the lock surface map before the screen freezes
            sleep_now
        else
            schedule_suspend
        fi
    fi
    ;;
lid-open)
    cancel_pending
    ;;
idle-suspend)
    # Idling on mains is free; stay awake and keep working.
    on_ac && exit 0
    lock
    sleep 1
    sleep_now
    ;;
*)
    echo "usage: ${0##*/} {lid-close|lid-open|idle-suspend}" >&2
    exit 2
    ;;
esac
