[user]
	email = abhigyakrishna21@gmail.com
	name = AbhigyaKrishna
	signingkey = C2347C0B36876168
[core]
	autocrlf = input
	ui = true
	preloadindex = false
	filemode = true
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	; Follow the terminal rather than pinning a theme, so this matches the
	; adw-dark/light switch instead of fighting it.
	syntax-theme = ansi
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
	algorithm = histogram
[safe]
	directory = *
[init]
	defaultbranch = main
[gpg]
	program = gpg
[commit]
	gpgsign = true
[tag]
	gpgsign = true
