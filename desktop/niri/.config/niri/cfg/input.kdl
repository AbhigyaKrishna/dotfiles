// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            //If you want to overwrite your keyboard layout,
            // uncomment the line below and change the layout accordingly.
            //layout "us" // Use the American keyboard layout
        }
        numlock // Enable numlock on startup

        // Defaults are 600ms before a key repeats at 25/sec, which feels
        // sluggish holding a cursor key through code.
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap // Enable tap-to-click
        natural-scroll // Enable natural (macOS-style) scrolling
        dwt // Disable While Typing — stops a palm brushing the pad from
            // jumping the cursor mid-sentence. Not on by default in niri.
    }

    // Focus what the pointer is over, but never scroll the view to do it.
    // Without the limit, nudging the mouse toward the second monitor can pull
    // focus off a game that has not grabbed the cursor — losing keyboard input
    // mid-match. gamescope's --force-grab-cursor already covers wrapped
    // launches; this is for everything else.
    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth // Enable workspace back & forth switching
}
