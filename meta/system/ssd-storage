#!/usr/bin/env python3
"""Move this host's disposable storage at boot; keep recovery backups on SSD."""

import argparse
import datetime
import fcntl
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

SSD_UUID = "9fed50af-aba4-46c4-92e7-5a8ebf9f7f37"
NVME_UUID = "09e84c23-5d8c-45a1-ab45-b174ee3741a4"
SSD = Path("/run/media/abhigya/SSD")
STORAGE = SSD / "system-storage"
CONFIG = Path("/etc/ssd-storage")
PROGRAM = Path("/usr/local/sbin/ssd-storage")
TOP = Path("/run/ssd-storage-nvme")
RSYNC = ["rsync", "-aHAXSx", "--numeric-ids", "--fsync"]
BEGIN = "# BEGIN ssd-storage\n"
END = "# END ssd-storage\n"
CACHES = (
    ".cache",
    ".gradle",
    ".npm",
    ".cargo/registry",
    ".cargo/git",
    ".bun/install/cache",
    "go/pkg/mod",
    "go/pkg/sumdb",
    ".m2/repository",
    ".m2/wrapper",
    ".nuget/packages",
    ".rustup/tmp",
    ".rustup/downloads",
    ".local/share/pnpm/store",
    ".local/share/NuGet/http-cache",
    ".android/cache",
    ".pub-cache",
)
CACHE_NAMES = {
    "Cache",
    "cache",
    "caches",
    "Code Cache",
    "GPUCache",
    "DawnCache",
    "CachedData",
    "CachedProfilesData",
    "CachedExtensionVSIXs",
    "CachedExtensions",
}


def run(*args, capture=False):
    return subprocess.run(
        [str(arg) for arg in args],
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
    ).stdout


def require_ssd():
    uuid = run("findmnt", "-nro", "UUID", "--mountpoint", SSD, capture=True).strip()
    if uuid != SSD_UUID:
        raise RuntimeError(f"{SSD} must be mounted from UUID={SSD_UUID}; got {uuid!r}")
    if (
        run("findmnt", "-nro", "FSTYPE", "--mountpoint", SSD, capture=True).strip()
        != "ext4"
    ):
        raise RuntimeError(
            "Expected the existing ext4 SSD; refusing another filesystem"
        )


def application_caches(home):
    configuration = home / ".config"
    caches = []
    for directory, children, _ in os.walk(configuration):
        if len(Path(directory).relative_to(configuration).parts) >= 3:
            children.clear()
            continue
        for name in list(children):
            cache = Path(directory) / name
            if name in CACHE_NAMES and not cache.is_symlink():
                caches.append(str(cache.relative_to(home)))
                children.remove(name)
    return sorted(caches)


def storage_entries(user):
    account = pwd.getpwnam(user)
    home = Path(account.pw_dir)
    if home != Path("/home") / user:
        raise RuntimeError("This host's migration expects /home/<user>")
    entries = [
        {
            "source": "@cache",
            "target": "/var/cache",
            "destination": "cache",
            "mode": 0o755,
        },
        {
            "source": "@tmp",
            "target": "/var/tmp",
            "destination": "var-tmp",
            "mode": 0o1777,
        },
    ]
    for cache in (*CACHES, *application_caches(home)):
        entries.append(
            {
                "source": f"@home/{user}/{cache}",
                "target": str(home / cache),
                "destination": f"users/{user}/{cache}",
                "mode": 0o700,
                "uid": account.pw_uid,
                "gid": account.pw_gid,
            }
        )
    return entries


def fstab_escape(path):
    return (
        str(path)
        .replace("\\", "\\134")
        .replace(" ", "\\040")
        .replace("\t", "\\011")
        .replace("\n", "\\012")
    )


def render_fstab(original, entries):
    targets = {fstab_escape(entry["target"]) for entry in entries} | {"/tmp"}
    lines = []
    in_block = False
    for line in original.splitlines(keepends=True):
        if line == BEGIN:
            in_block = True
        elif line == END:
            in_block = False
        elif not in_block:
            fields = line.split()
            if (
                line.lstrip().startswith("#")
                or len(fields) < 2
                or fields[1] not in targets
            ):
                lines.append(line)
    while lines and not lines[-1].strip():
        lines.pop()
    lines.append("\n" + BEGIN)
    for entry in entries + [{"target": "/tmp", "destination": "tmp"}]:
        destination = STORAGE / entry["destination"]
        options = "bind,nosuid,nodev,x-systemd.requires=ssd-storage-migrate.service"
        lines.append(
            f"{fstab_escape(destination)} {fstab_escape(entry['target'])} none {options} 0 0\n"
        )
    lines.append(END)
    return "".join(lines)


def write_atomic(path, content, mode=0o600):
    path = Path(path)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        stream.write(content)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.chmod(mode)
    temporary.replace(path)


def check_installation(user):
    require_ssd()
    for command in ("rsync", "btrfs", "snapper", "systemctl", "findmnt"):
        if not shutil.which(command):
            raise RuntimeError(f"Missing prerequisite: {command}")
    entries = storage_entries(user)
    original = Path("/etc/fstab").read_text()
    if not (CONFIG / "original.fstab").exists():
        for target, subvolume in (
            ("/", "@"),
            ("/home", "@home"),
            ("/var/cache", "@cache"),
            ("/var/tmp", "@tmp"),
        ):
            uuid = run(
                "findmnt", "-nro", "UUID", "--mountpoint", target, capture=True
            ).strip()
            root = run(
                "findmnt", "-nro", "FSROOT", "--mountpoint", target, capture=True
            ).strip()
            if uuid != NVME_UUID or root != f"/{subvolume}":
                raise RuntimeError(f"Unexpected source for {target}: {uuid} {root}")
    for entry in entries[2:]:
        path = Path(entry["target"])
        if path.resolve() != path or (path.exists() and not path.is_dir()):
            raise RuntimeError(f"Cannot migrate a symlink or non-directory: {path}")
    if STORAGE.is_symlink() or (STORAGE.exists() and STORAGE.stat().st_uid != 0):
        raise RuntimeError(f"{STORAGE} must be a root-owned directory")
    return entries, original


def prepare_storage(entries):
    CONFIG.mkdir(mode=0o700, exist_ok=True)
    STORAGE.mkdir(mode=0o711, exist_ok=True)
    # Applications canonicalize bind-mounted cache paths back to this parent.
    # Allow traversal; private backup and user directories protect their contents.
    STORAGE.chmod(0o711)
    # The SSD's existing mountpoint is writable by everyone. Sticky semantics
    # prevent other accounts replacing the root-owned storage directory.
    SSD.chmod(SSD.stat().st_mode | 0o1000)
    for entry in entries:
        destination = STORAGE / entry["destination"]
        destination.mkdir(parents=True, exist_ok=True)
        destination.chmod(entry["mode"])
        os.chown(destination, entry.get("uid", 0), entry.get("gid", 0))
        target = Path(entry["target"])
        missing = []
        while not target.exists():
            missing.append(target)
            target = target.parent
        for target in reversed(missing):
            target.mkdir(mode=entry["mode"])
            os.chown(target, entry.get("uid", 0), entry.get("gid", 0))
    (STORAGE / "tmp").mkdir(exist_ok=True)
    (STORAGE / "tmp").chmod(0o1777)


def install(user):
    entries, original = check_installation(user)
    prepare_storage(entries)
    previous_entries = (
        json.loads((CONFIG / "entries.json").read_text())
        if (CONFIG / "entries.json").exists()
        else None
    )
    if not (CONFIG / "original.fstab").exists():
        shutil.copy2("/etc/fstab", CONFIG / "original.fstab")
        for name in ("root", "home"):
            shutil.copy2(f"/etc/snapper/configs/{name}", CONFIG / f"snapper-{name}")
    write_atomic(CONFIG / "entries.json", json.dumps(entries, indent=2) + "\n")
    source = Path(__file__).resolve()
    if source != PROGRAM:
        shutil.copyfile(source, PROGRAM)
        PROGRAM.chmod(0o755)
    for filename, content in UNITS.items():
        write_atomic(Path("/etc/systemd/system") / filename, content, 0o644)
    candidate = render_fstab(original, entries)
    write_atomic(CONFIG / "candidate.fstab", candidate, 0o644)
    run("findmnt", "--verify", "--tab-file", CONFIG / "candidate.fstab")
    write_atomic(Path("/etc/fstab"), candidate, 0o644)
    if entries != previous_entries:
        (STORAGE / "migration-complete").unlink(missing_ok=True)
    run("systemctl", "daemon-reload")
    run("systemctl", "enable", "ssd-storage-backup.timer")
    print(
        "Installed. Reboot when ready; first boot moves caches before applications start."
    )
    print("Snapshots are only pruned after the first SSD backup has succeeded.")
    print(f"Original configuration: {CONFIG}")


def mount_nvme():
    TOP.mkdir(mode=0o700, exist_ok=True)
    if os.path.ismount(TOP):
        raise RuntimeError(f"Unexpected existing mount: {TOP}")
    run("mount", "-t", "btrfs", "-o", "subvolid=5,noatime", f"UUID={NVME_UUID}", TOP)


def move_directory(source, destination):
    if not source.exists():
        return
    if source.is_symlink() or not source.is_dir():
        raise RuntimeError(f"Unexpected cache source: {source}")
    # At early boot there are no application writers. Each source file is
    # unlinked only after rsync has successfully transferred it; retrying a
    # partially completed move merges the remaining files without --delete.
    run(*RSYNC, "--checksum", "--remove-source-files", f"{source}/", f"{destination}/")
    run("sync", "-f", destination)
    for directory, _, _ in os.walk(source, topdown=False):
        path = Path(directory)
        if path != source:
            path.rmdir()
    if any(source.iterdir()):
        raise RuntimeError(f"Migration left files behind in {source}")


def migrate():
    require_ssd()
    if (STORAGE / "migration-complete").exists():
        return
    # Running manually after login could race applications. systemd runs this
    # service before local-fs.target and therefore before any user sessions.
    if os.environ.get("SSD_STORAGE_EARLY_BOOT") != "1":
        raise RuntimeError("Migration must run through the early-boot systemd service")
    entries = json.loads((CONFIG / "entries.json").read_text())
    mount_nvme()
    try:
        for entry in entries:
            print(f"Moving {entry['target']} to SSD", flush=True)
            destination = STORAGE / entry["destination"]
            move_directory(TOP / entry["source"], destination)
            if entry["target"] in ("/var/cache", "/var/tmp"):
                destination.chmod(entry["mode"])
        write_atomic(STORAGE / "migration-complete", "Caches moved successfully.\n")
        run("sync", "-f", STORAGE)
    finally:
        run("umount", TOP)


def copy_version(source, destination, previous=None, excludes=()):
    destination.mkdir(parents=True, exist_ok=True)
    arguments = [*RSYNC, "--checksum", "--delete"]
    if previous is not None:
        arguments.append(f"--link-dest={previous}")
    for exclude in excludes:
        arguments.append(f"--exclude=/{exclude}")
    run(*arguments, f"{source}/", f"{destination}/")


def minimal_snapshots():
    for name in ("root", "home"):
        run(
            "snapper",
            "-c",
            name,
            "set-config",
            "NUMBER_CLEANUP=yes",
            "NUMBER_LIMIT=4",
            "NUMBER_LIMIT_IMPORTANT=2",
            "TIMELINE_CLEANUP=yes",
            "TIMELINE_LIMIT_HOURLY=1",
            "TIMELINE_LIMIT_DAILY=1",
            "TIMELINE_LIMIT_WEEKLY=0",
            "TIMELINE_LIMIT_MONTHLY=0",
            "TIMELINE_LIMIT_QUARTERLY=0",
            "TIMELINE_LIMIT_YEARLY=0",
        )
        run("snapper", "-c", name, "cleanup", "number")
        run("snapper", "-c", name, "cleanup", "timeline")


def backup():
    require_ssd()
    if not (STORAGE / "migration-complete").exists():
        raise RuntimeError("Reboot and complete cache migration before backing up")
    backups = STORAGE / "backups"
    backups.mkdir(mode=0o700, exist_ok=True)
    with (backups / ".lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        backup_locked(backups)


def create_backup_snapshots():
    snapshots = []
    try:
        for name in ("root", "home", "root-home", "srv"):
            subvolume = {
                "root": "@",
                "home": "@home",
                "root-home": "@root",
                "srv": "@srv",
            }[name]
            snapshot = TOP / f"ssd-backup-{name}"
            if snapshot.exists():
                run("btrfs", "subvolume", "delete", snapshot)
            run("btrfs", "subvolume", "snapshot", "-r", TOP / subvolume, snapshot)
            snapshots.append(snapshot)
    except BaseException:
        for snapshot in snapshots:
            run("btrfs", "subvolume", "delete", snapshot)
        raise
    return snapshots


def copy_backup_snapshots(snapshots, pending, previous):
    for snapshot in snapshots:
        name = snapshot.name.removeprefix("ssd-backup-")
        excludes = [".snapshots"]
        if name == "home":
            entries = json.loads((CONFIG / "entries.json").read_text())
            excludes.extend(
                entry["target"].removeprefix("/home/") for entry in entries[2:]
            )
        copy_version(
            snapshot, pending / name, previous / name if previous else None, excludes
        )


def backup_locked(backups):
    versions = sorted(
        path for path in backups.glob("20??????T??????Z") if path.is_dir()
    )
    previous = versions[-1] if versions else None
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    pending = backups / ".incomplete"
    # Never update hardlinks from an interrupted copy in place: changing their
    # metadata could change an older published version's metadata as well.
    if pending.exists():
        shutil.rmtree(pending)
    pending.mkdir(mode=0o700)
    snapshots = []
    mount_nvme()
    try:
        snapshots = create_backup_snapshots()
        copy_backup_snapshots(snapshots, pending, previous)
        copy_version(
            Path("/boot"), pending / "boot", previous / "boot" if previous else None
        )
        write_atomic(
            pending / "README",
            "root, home, root-home and srv are read-only Btrfs snapshot copies.\n"
            "boot is a live copy. Each source is captured separately.\n"
            "Caches, /tmp, /var/tmp, /var/log, /swap and older snapshots are excluded.\n",
        )
        run("sync", "-f", pending)
        pending.rename(backups / stamp)
        run("sync", "-f", backups)
    finally:
        try:
            for snapshot in snapshots:
                run("btrfs", "subvolume", "delete", snapshot)
        finally:
            run("umount", TOP)
    # No local recovery points are pruned until an SSD version is published.
    minimal_snapshots()
    for expired in sorted(versions + [backups / stamp])[:-7]:
        shutil.rmtree(expired)
    print(f"Backup complete: {backups / stamp}")


UNITS = {
    "ssd-storage-migrate.service": f"""[Unit]
Description=Move NVMe caches to SSD before mounting them
DefaultDependencies=no
RequiresMountsFor={SSD}
Before=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
Environment=SSD_STORAGE_EARLY_BOOT=1
ExecStart={PROGRAM} migrate
RemainAfterExit=yes
TimeoutStartSec=infinity
StandardOutput=journal+console
""",
    "ssd-storage-backup.service": f"""[Unit]
Description=Daily versioned SSD recovery backup and minimal NVMe snapshots
RequiresMountsFor={SSD} /home /root /srv /boot
After=local-fs.target

[Service]
Type=oneshot
ExecStart={PROGRAM} backup
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=infinity
""",
    "ssd-storage-backup.timer": """[Unit]
Description=Daily SSD recovery backup

[Timer]
OnCalendar=daily
OnBootSec=15min
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
""",
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("plan", "install", "migrate", "backup"))
    parser.add_argument("--user", default=os.environ.get("SUDO_USER", "abhigya"))
    args = parser.parse_args()
    if args.command == "plan":
        print(render_fstab(Path("/etc/fstab").read_text(), storage_entries(args.user)))
        return
    if os.geteuid() != 0:
        parser.error("Run this command with sudo")
    {"install": lambda: install(args.user), "migrate": migrate, "backup": backup}[
        args.command
    ]()


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"ssd-storage: {error}", file=sys.stderr)
        sys.exit(1)
